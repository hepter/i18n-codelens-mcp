{
  "name": "i18n-codelens-mcp",
  "version": "2.0.0",
  "description": "MCP server for i18n translation management: inspect, audit and safely edit locale JSON files from AI agents (Claude Code, Cursor, Antigravity, Copilot, Codex, Gemini).",
  "private": false,
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "bin": {
    "i18n-codelens-mcp": "out/bin.js"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "require": "./out/index.js",
      "default": "./out/index.js"
    },
    "./server": {
      "types": "./out/server.d.ts",
      "require": "./out/server.js",
      "default": "./out/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out/**",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p ./ && node ./scripts/ensure-bin-mode.cjs",
    "watch": "tsc -watch -p ./",
    "check": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "i18n",
    "localization",
    "translation",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude-code",
    "antigravity",
    "i18next",
    "locales",
    "translation-management"
  ],
  "author": {
    "email": "mustafakuru042@gmail.com",
    "name": "Mustafa Kuru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hepter/i18n-codelens-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/hepter/i18n-codelens-mcp/issues"
  },
  "homepage": "https://github.com/hepter/i18n-codelens-mcp#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fast-glob": "^3.3.2",
    "fastest-levenshtein": "^1.0.16",
    "ignore": "^7.0.5",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "mcpName": "io.github.hepter/i18n-codelens-mcp"
}
